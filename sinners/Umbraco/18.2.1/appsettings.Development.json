{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Sinners": {
    "AutoLoginEmail": "admin@example.com",
    "SeedSins": true
  },
  "Umbraco": {
    "CMS": {
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Admin",
        "UnattendedUserEmail": "admin@example.com",
        "UnattendedUserPassword": "demo-_BzYzKHDHsIx",
        "UnattendedTelemetryLevel": "Detailed"
      },
      "Hosting": {
        "Debug": true
      },
      "Global": {
        "TimeOut": "1.00:00:00"
      },
      "Security": {
        "BackOfficeHost": "http://localhost:5180",
        "KeepUserLoggedIn": true,
        "AllowConcurrentLogins": true
      }
    }
  }
}
